<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="easy_dialog_style" parent="@style/Theme.AppCompat.Light.Dialog">
        <!-- Dialog的windowFrame框 -->
        <item name="android:windowFrame">@null</item>
        <!-- 是否浮现在activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 是否半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- 是否显示title -->
        <item name="android:windowNoTitle">true</item>
        <!-- Dialog的背景 透明 transparent-->


        <item name="android:windowBackground">@drawable/se_btn_quanxian_xpq</item>
        <!--  后面的activity背景是否模糊显示 -->
        <item name="android:backgroundDimEnabled">true</item>

    </style>

    <style name="XPQTheme.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>


    <style name="PayTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="BottomBtnStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/roundbtn_tran_xpq</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">@drawable/btn_black_text_color_xpq</item>
    </style>

    <!-- 音乐模块：浅色主题，与 MainActivity 的 Theme.AndroidAuto（Light + gold #F6D36B 主色）保持一致 -->
    <style name="Theme.XpqMusic" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/music_bg</item>
        <item name="android:statusBarColor">@color/music_bg</item>
        <item name="android:navigationBarColor">@color/music_bg</item>
        <item name="colorPrimary">@color/music_accent</item>
        <item name="colorAccent">@color/music_accent</item>
        <item name="android:textColor">@color/music_text</item>
    </style>

    <style name="Theme.XpqMusic.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorPrimary">@color/music_accent</item>
    </style>

</resources>