<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用（提醒总开关关时）：统一灰，突出“不可用” -->
    <item android:color="#BDBDBD" android:state_enabled="false" />
    <!-- 开启：金色强调 -->
    <item android:color="@color/music_accent" android:state_checked="true" />
    <!-- 关闭（可用）：深灰，与开启明显区分 -->
    <item android:color="#8A8A8A" />
</selector>
